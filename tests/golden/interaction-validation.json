    { "name": "valor × tasa redondeado no admite tres centavos", "family": "declaracion", "overrides": { "valorMonedaNegociacion": "1", "tasaCambioDolares": "0.005", "valorTotalDolares": "0.03" }, "expectedFields": ["valorTotalDolares"] }
