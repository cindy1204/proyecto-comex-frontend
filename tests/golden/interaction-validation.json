    { "name": "total con dos centavos de diferencia", "family": "declaracion", "overrides": { "valorMonedaNegociacion": "100", "tasaCambioDolares": "0.005", "valorTotalDolares": "0.52" }, "expectedFields": ["valorTotalDolares"] },
